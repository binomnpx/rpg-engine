cols = {2,3,12}

weights = {
	[0] = {1,1,1},
	{1,1,1},
	{1,50,1},
	{0,1,90}
}

dirs = {
	
	{x = 0, y = -1},
	{x = 1, y = 0},
	{x = 0, y = 1},
	{x = -1, y = 0}
	
}

