end
-->8
-- functions

function collapse(tile)
	
	-- sample using weights
	
	local sum = 0
	local csum = {}
	
	for w in all(weights[tile.w]) do
		sum += w
		add(csum,sum)
	end
	
	local r = rnd(1)
	local i = 0
	
	for x in all(csum) do
		
		i += 1
		
		if r < x/sum then
			break
		end
		
	end
	
	-- set pixel
	
	pset(tile.x, tile.y, cols[i])
		
	tile.s = i
	
	del(modified, tile)
	modified[tile] = nil
	
end


function propogate(tile)

	for dir in all(dirs) do
		
		local x = mid(0, tile.x + dir.x, 127)
		local y = mid(0, tile.y + dir.y, 127)
		
		local adjacent = tiles[x][y]
		
		if adjacent then
			
			update(adjacent, tile)
			
		end
		
	end
	
	tiles[tile.x][tile.y] = nil
	
end


function update(tile1, tile2)
	
	tile1.w = tile2.s
	
	-- calc entropy
	
	local sum = 0
	
	for w in all(weights[tile1.w]) do
		sum += w
	end
	
	local e = 0
	
	for w in all(weights[tile1.w]) do
		e -= w/sum * sqrt(w/sum)
--		e -= w/sum * log2[ceil(w/sum*100+.0001)]
	end
	
	tile1.e = e
	
--	pset(tile1.x, tile1.y, tile1.e)
	
	if not modified[tile1] then
		
		add(modified, tile1)
		modified[tile1] = true
		
	end
	
end
