pico-8 cartridge // http://www.pico-8.com
version 43
__lua__


function _init()
	
	cls()
	
	tiles = {}
	
	for i = 0, 127 do
		
		tiles[i] = {}
		
		for j = 0, 127 do
			
			local tile = {}
			
			tile.x = i
			tile.y = j
			
			tile.w = 0
			
			tiles[i][j] = tile
			
		end
		
	end
	
	modified = {}
	
	local tile = tiles[flr(rnd(128))][flr(rnd(128))]
	
	collapse(tile)
	propogate(tile)
	
end


