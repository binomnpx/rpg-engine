__lua__

#include core/config.lua

#include core/control.lua
#include core/save.lua

#include util/math.lua
#include util/observer.lua

#include world/camera.lua
#include world/collision.lua
#include world/maps.lua
#include world/spawn.lua
#include world/terrain.lua

#include entities/player.lua
#include entities/npcs.lua
#include entities/containers.lua
#include entities/scenery.lua
#include entities/burlaps.lua

#include gameplay/stats.lua
#include gameplay/items.lua
#include gameplay/weapons.lua
#include gameplay/inventory.lua
#include gameplay/effects.lua
#include gameplay/combat.lua
#include gameplay/actions.lua
#include gameplay/interactions.lua

#include ui/hud.lua
#include ui/menus.lua
#include ui/messages.lua
#include ui/dialog.lua

#include audio/sfx.lua
#include audio/music.lua

#include util/table.lua

function _init()
	
	-- core
	ctrl:init()

	-- world
	terrain:init()
	scenery:init()
	cam:init()
	collision:init()

	-- entities
	npcs:init()
	containers:init()
	player:init()
	
end

function _update60()
	
	-- core
	ctrl:update()
	
	-- world
	cam:update()
	
	-- ui
	messages:update()
	
end

function _draw()
	
	cls()
	
	camera(cam.x, cam.y)
	
	-- world
	map() -- terrain:draw()
	scenery:draw()
	
	-- entities
	npcs:draw()
	containers:draw()
	burlaps:draw()
	player:draw()
	
	-- ui
	messages:draw()
	
	camera()
	
	menus:draw()
	scan:draw()
	
end

