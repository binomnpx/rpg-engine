?readLines
# paste your lua file here as a single string
txt <- paste(readLines("core/control.lua"), collapse = "\n")
cat(txt)
# paste your lua file here as a single string
txt <- paste(readLines("core/control.lua"), collapse = "\n")
INDENT <- "\t"
block_start   <- "\\b(function|then|do|repeat)\\b"
control_start <- "^\\s*(if|for|while)\\b"
block_end     <- "^\\s*(end|until)\\b"
else_block    <- "^\\s*(else|elseif)\\b"
lines <- strsplit(txt, "\n", fixed = TRUE)[[1]]
indent <- 0
out_lines <- character()
for (line in lines) {
# trim trailing whitespace
line <- sub("[ \t]+$", "", line)
# remove all leading whitespace
stripped <- sub("^\\s+", "", line)
# dedent before line
if (grepl(block_end, stripped)) {
indent <- max(indent - 1, 0)
}
if (grepl(else_block, stripped)) {
indent <- max(indent - 1, 0)
}
out_lines <- c(out_lines, paste0(strrep(INDENT, indent), stripped))
# indent after line
if (grepl(control_start, stripped) || grepl(block_start, stripped)) {
indent <- indent + 1
}
if (grepl(else_block, stripped)) {
indent <- indent + 1
}
out <- paste(out_lines, collapse = "\n")
cat(out)
writeLines(out, "dummy.lua")
source("~/.active-rstudio-document", echo=TRUE)
