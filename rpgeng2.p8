-- npcs and messages

local indices = shuffle(128*64)

for i = 1, 100 do
	 
  mset(
    indices[i] % 128,
    flr(indices[i] / 128),
    32+flr(rnd(4))
  )
	 
end


messages = {}

function add_message(msg, x, y)
	 
	 add(messages, {
	   
	   x = x,
	   y = y-1,
	   
--	   msg = msg,
	   
	   ♥ = 40,
	   
	   upd = function(self)
	     
	     self.♥ -= 1
	     
	     if self.♥ == 0 then
	     	 
	     	 del(messages, self)
	     	 
      end
	     
	   end,
	   
	   drw = function(self)
	     
	     print(
	       "\^o0ff"..msg,
	       self.x*8 + 4 - #msg*4/2,
	       self.y*8,
	       7
	     )
	     
	   end
	   
	 })
	 
end
