apple = {
  
  name = "apple",
  
  use = function()
    
    add_message("yum", player.x, player.y)
    
    deli(inventory, inventory.index+1)
    
  end
  
}


orange = {
  
  name = "orange",
  
  use = function()
    
    add_message("yum", player.x, player.y)
    
    deli(inventory, inventory.index+1)
    
  end
  
}


banana = {
  
  name = "banana",
  
  use = function()
    
    add_message("yum", player.x, player.y)
    
    deli(inventory, inventory.index+1)
    
  end
  
}


----------
-- gear --
----------

trident = {
  
  name = "trident",
  
  use = function()
    
    if player.hand == trident then
      
      player.hand = nil
      
    else
      
      player.hand = trident
      
    end
    
  end,
  
  drw = function(px, py)
    
    if player.s == 16 then
    	 
--    	 local xos = player.flip_x and -1 or 0
    	 local xos = -tonum(player.flip_x)
    	 
    	 spr(19, px+xos, py)
    	 
    elseif player.s == 17 then
    	 
    	 spr(19, px+6, py)
    	 
    else
    	 
    	 spr(19, px-1, py)
    	 
    end
    
  end
  
}


sword = {
  
  name = "sword",
  
  use = function()
    
    if player.hand == sword then
      
      player.hand = nil
      
    else
      
      player.hand = sword
      
    end
    
  end,
  
  drw = function(px, py)
    
    if player.s == 16 then
    	 
    	 local xos = -tonum(player.flip_x)
    	 
    	 spr(20, px+xos, py-1)
    	 
    elseif player.s == 17 then
    	 
    	 spr(20, px+6, py-1)
    	 
    else
    	 
    	 spr(20, px-1, py-1)
    	 
    end
    
  end
  
}


staff = {
  
  name = "staff",
  
  use = function()
    
    if player.hand == staff then
      
      player.hand = nil
      
    else
      
      player.hand = staff
      
    end
    
  end,
  
  drw = function(px, py)
    
    if player.s == 16 then
    	 
    	 local xos = -tonum(player.flip_x)*6
    	 
    	 spr(21, px+xos, py, 1, 1, player.flip_x)
    	 
    elseif player.s == 17 then
    	 
    	 spr(21, px+1, py, 1, 1, true)
    	 
    else
    	 
    	 local xos = -1 - tonum(player.flip_x)*5
    	 
    	 spr(21, px+xos, py, 1, 1, player.flip_x)
    	 
    end
    
  end
  
}

