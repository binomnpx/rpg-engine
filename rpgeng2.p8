--  -menus
--  -status bars
--  -map

function _init()
		
		-- global vars
		
		ctrl = "player"
		
		add(inventory, trident)
		
end


function _update60()
		
		
		-- player input
		
		if ctrl == "player" then
    
		  player.upd()
    
  elseif ctrl == "inventory" then
  	 
  	 inventory.upd()
  	 
  end
		
		
		-- handle screen transition
		
		if ctrl == "camera" then
		-- camera movement queued
		  
		  cam.upd()
			 
		end
		
		
		-- update messages
		
		for m in all(messages) do
			 
			 m:upd()
			 
		end
		
end


function _draw()
		
		cls()
		
		camera(cam.x, cam.y)
		
		
		-- background
		
		map()
		
		
		-- player
		
		player.drw()
		
		
		-- messages
		
		for m in all(messages) do
			 
			 m:drw()
			 
		end
		
		
		-- inventory menu
		
		if ctrl == "inventory" then
			 
				camera()
				
			 inventory.drw()
			 
		end
		
end


---------------
-- functions --
---------------

function shuffle(n)
	 
		local indices = {}
		
		for i = 0, n-1 do
			 
			 add(indices, i)
			 
		end
		
		for i = #indices, 1, -1 do
			 
			 local j = flr(rnd(i))+1
			 
			 indices[i], indices[j] = indices[j], indices[i]
			 
		end
		
		return indices
	 
end
