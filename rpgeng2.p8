-- scenery

local indices = shuffle(128*64)

for i = 1,400 do
	 
	 local s = 48+flr(rnd(8))
  
  for _ = 1, ceil(rnd(4)) do
  	 
  	 mset(
  	   indices[i] % 128 + flr(rnd(5)),
  	   flr(indices[i]) / 128 + flr(rnd(5)),
  	   s
  	 )
  	 
  end
  
end


