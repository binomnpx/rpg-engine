--  -menus
--  -status bars
--  -map

function _init()
		
		
		-- global vars
		
		ctrl = "player"
		
		⧗ = 0 -- pauses ctrl
		
		
		-- debug
		
		add(player.inventory, trident)
--		add(player.inventory, sword)
		add(player.inventory, potion)
		add(player.inventory, scan)
		
		
end


function _update60()
				
		⧗ = max(0, ⧗-1)
		
	 -- handle player input
		
		if ⧗ == 0 then
				
				if ctrl == "player" then
				  
				  player.upd()
				  
				elseif ctrl == "menuing" then
					 
					 menus[#menus]:upd()
					 
				elseif ctrl == "scan" then
					 
					 scan.upd()
					 
				elseif ctrl == "target" then
					 
					 target.upd()
					 
				end

  end
		
		
		-- handle camera queue
		
		if ctrl == "camera" then
		  
		  cam.upd()
			 
		end
		
		
		-- handle messages
		
		for m in all(messages) do
			 
			 m:upd()
			 
		end
		
		
		-- handle attacks
		
		for a in all(attacks) do
			 
			 a:upd()
			 
		end
		
		
		-- handle objects
		
		local il = max(0, flr(cam.x/8)-1)
		local ir = min(127, flr(cam.x/8)+16)
		
		local jl = max(0, flr(cam.y/8)-1)
		local jr = min(63, flr(cam.y/8)+16)
		
		for i = il, ir do
			 
			 for j = jl, jr do
			 	 
			 	 local obj = grid[i][j]
			 	 
			 	 if obj and obj.upd then
			 	 	 
			 	 	 obj:upd()
			 	 	 
      end
			 	 
    end
			 
		end
		
		
end


----------
-- draw --
----------

function _draw()
		
		cls()
		
		camera(cam.x, cam.y)
		
		
		-- background
		
		map()
		
		
		-- grid objects
		
		local il = max(0, flr(cam.x/8)-1)
		local ir = min(127, flr(cam.x/8)+16)
		
		local jl = max(0, flr(cam.y/8)-1)
		local jr = min(63, flr(cam.y/8)+16)
		
		for i = il, ir do
			 
			 for j = jl, jr do
			 	 
			 	 local obj = grid[i][j]
			 	 
			 	 if obj then
			 	 	 
			 	 	 palt(0, false)
			 	 	 spr(obj.s, obj.x*8, obj.y*8)
			 	 	 palt(0, true)
			 	 	 
      end
			 	 
    end
			 
		end
		
		
		-- player
		
		player.drw()
		
		
		-- messages
		
		for m in all(messages) do
			 
			 m:drw()
			 
		end
		
		
		-- menus
		
		if ⧗ == 0 and
		  ctrl == "menuing"
		then
			 
				camera()
				
			 menus[#menus]:drw()
			 
		end
		
		
		-- scan icon
		
		if ⧗ == 0 and
		  cam.ctrl == "scan"
		then
			 
			 camera()
			 
--			 print("\^o0ff☉", 119, 121, 7)
			 ?"\^o0ff☉", 119, 121, 7
			 
		end
		
		
		if ctrl == "target" then
			 
			 target.drw()
			 
		end
		
end


---------------
-- functions --
---------------

function shuffle(n)
	 
		local indices = {}
		
		for i = 0, n-1 do
			 
			 add(indices, i)
			 
		end
		
		for i = #indices, 1, -1 do
			 
			 local j = flr(rnd(i))+1
			 
			 indices[i], indices[j] = indices[j], indices[i]
			 
		end
		
		return indices
	 
end
