messages = {}

function add_message(msg, x, y)
	 
	 ⧗ = 20 -- pause user input
	 
	 add(messages, {
	   
	   x = x,
	   y = y-1,
	   
--	   msg = msg,
	   
	   ♥ = 40,
	   
	   upd = function(self)
	     
	     self.♥ -= 1
	     
	     if self.♥ == 0 then
	     	 
	     	 del(messages, self)
	     	 
      end
	     
	   end,
	   
	   drw = function(self)
	     
	     print(
	       "\^o0ff"..msg,
	       self.x*8 + 4 - #msg*4/2,
	       self.y*8,
	       7
	     )
	     
	   end
	   
	 })
	 
end
-->8
-- menus

menus = {}

function add_menu(items)
	 
	 local menu = {
			 
			 index = 0,
			 
			 drw = function(self)
		    
		    local width = 48
		    
		    local height = mid(10, 10 + (#self-1)*8, 66)
		    
		    rectfill(
		      40,
		      31,
		      40 + width,
		      31 + height,
		      0
		    )
		    
		    rect(
		      40,
		      31,
		      88,
		      31 + height,
		      7
		    )
		    
		    if #self > 0 then
		    	 
		    	 for i = 1, #self do
		    	 	 
		    	 	 print(
		    	 	   self[i].name,
				    	   40 + 3 + 5,
				    	   31 + 3 + (i-1)*8,
				    	   7
				    	 )
				    	 
				    	 spr(
				    	   58, 40 + 3,
				    	   31 + 3 + (self.index)*8
				    	 )
		    	 	 
		      end
		    	 
		    end
		    
		  end,
		  
		  upd = function(self)
		    
		    
		    -- return
		    
		    if btnp(🅾️) then
		    	 
		    	 deli(menus, #menus)
		    	 
		    end
		    
		    
		    -- move up
		    
		    if btnp(⬆️) then
		    	 
		    	 self.index -= 1
		    	 
		    end
		    
		    
		    -- move down
		    
		    if btnp(⬇️) then
		    	 
		    	 self.index += 1
		    	 
		    end
		    
		    
		    -- loop
		    
		    self.index %= #self
		    
		    
		    -- use/invoke
		    
		    if btnp(❎) and
		      #self > 0
		    then
		    	 
		    	 self[self.index+1]:use()
		    	 
		    end
		    
		    
		    -- return ctrl
		    
		    if #menus == 0 then
		    	 
		    	 ctrl = "player"
		    	 
      end
		    
		  end
		  
		}
		
		for item in all(items) do
			 
			 add(menu, item)
			 
		end
		
		add(menus, menu)
		
		ctrl = "menuing"
	 
end


--------------------
-- menu functions --
--------------------


-- delete item from current menu

function menu_delcurr()
	 
	 deli(menus[#menus], menus[#menus].index+1)
	 
end


-- delete item from previous menu

function menu_delprev()
	 
	 deli(menus[#menus-1], menus[#menus-1].index+1)
	 
end


-- return to previous menu

function menu_return()
	 
	 deli(menus, #menus)
	 
end


-- quit menuing

function menu_quit()
	 
	 menus = {}
	 
end


-- get item

function menu_get(n)
	 
	 return menus[#menus-n][menus[#menus-n].index+1]
	 
end
