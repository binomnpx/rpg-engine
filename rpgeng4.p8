-- cam

cam = {
  
  x = 0,
  y = 0,
  q = {}, -- movement queue
  ⧗ = {}, -- movement timer/length
  dxy = 0, -- movement step length (retained across entire queue)
  player_shift = false, -- shift player during screen transitions
  ctrl = "player", -- remember previous ctrl for when camera is done
  
  upd = function()
    
    local cam_q = cam.q[1]
    
		  cam.⧗[1] -= 1
    
			 if cam_q == "➡️" then
			   
			 	 cam.x += cam.dxy
			 	 
			 elseif cam_q == "⬅️" then
			   
			 	 cam.x -= cam.dxy
			 	 
			 elseif cam_q == "⬇️" then
			   
			 	 cam.y += cam.dxy
			 	 
			 elseif cam_q == "⬆️" then
			   
			 	 cam.y -= cam.dxy
			 	 
			 end
					 
				if cam.⧗[1] == 0 then
				-- camera done moving
				  
					 deli(cam.q, 1)
					 deli(cam.⧗, 1)
					 
				end
				
				if #cam.q == 0 then
					 
					 ctrl = cam.ctrl
					 cam.player_shift = false
					 
				end
    
  end
  
}
-->8
-- player and grid

player_sprite_left = 36--16
player_sprite_back = 37--17
player_sprite_front = 38--18

player_hand_pxl_l = 0
player_hand_pxl_r = -1

player_hand_pxl_back = 5
player_hand_pxl_back_flipped = 6

player_hand_pxl_front = -1
player_hand_pxl_front_flipped = 0

player = {

  x = 8,
  y = 8,
  s = player_sprite_left,
  
  flip_x = false,
  
  inventory = {},
  
  hand = nil,
  
  upd = function()
    
    --------------
    -- movement --
    --------------
    
    local x0 = player.x
    local y0 = player.y
    
    -- movement and sprites
    
    if btnp(⬅️) then
    	 
    	 player.x -= 1
    	 player.s = player_sprite_left
    	 player.flip_x = false
    	 
    end
    
    if btnp(➡️) then
    	 
    	 player.x += 1
    	 player.s = player_sprite_left
    	 player.flip_x = true
    	 
    end
    
    if btnp(⬆️) then
    	 
    	 player.y -= 1
    	 player.s = player_sprite_back
    	 
    end
    
    if btnp(⬇️) then
    	 
    	 player.y += 1
    	 player.s = player_sprite_front
    	 
    end
    
    player.x = mid(0, player.x, 127)
    player.y = mid(0, player.y, 63)
    
    -- collision and screen
    --  transition
    
    if grid[player.x][player.y] then
    -- collided, so dont move
    
    	 player.x = x0
    	 player.y = y0
    	 
    else
    -- player moved
    
      -- queue camera transition
    	 
    	 if player.x % 16 == 0 and
    	    x0 % 16 == 15
    	 then
    	 	 
    	 	 add(cam.q, "➡️")
    	 	 
      end
      
      if player.x % 16 == 15 and
    	    x0 % 16 == 0
    	 then
    	 	 
    	 	 add(cam.q, "⬅️")
    	 	 
      end
      
      if player.y % 16 == 0 and
    	    y0 % 16 == 15
    	 then
    	 	 
    	 	 add(cam.q, "⬇️")
    	 	 
      end
      
      if player.y % 16 == 15 and
    	    y0 % 16 == 0
    	 then
    	 	 
    	 	 add(cam.q, "⬆️")
    	 	 
      end
      
      
      if #cam.q > 0 then
		    -- give control to camera
		      
		      ctrl = "camera"
		      cam.ctrl = "player"
		      
		      for i = 1, #cam.q do
		      	 
		      	 add(cam.⧗, 64)
		      	 
        end
		      
		      cam.dxy = 2
		      
		      -- this tells player.drw
		      --  to shift player
		      --  when screen is
		      --  transitioning
		      
		      cam.player_shift = true
		      
		    end
    	 
    end
    
    
    -----------------
    -- interaction --
    -----------------
    
    -- interact with object
    
    if btnp(❎) then
    	 
    	 local xos = 0
    	 local yos = 0
    	 
    	 -- get offsets in
    	 --  direction player
    	 --  is facing
    	 
    	 if player.s == player_sprite_left then
    	 -- left/right
    	 
    	 	 if player.flip_x then
    	 	 -- right
    	 	 
    	 	 	 xos = 1
    	 	 	 
    	 	 else
    	 	 -- left
    	 	 
    	 	 	 xos = -1
    	 	 	 
        end
    	 	 
      elseif player.s == player_sprite_back then
      -- up
      
        yos = -1
        
      else
      -- down
      
        yos = 1
        
      end
    	 
    	 
    	 -- invoke object
    	 
    	 local ox = player.x+xos
    	 local oy = player.y+yos
    	 
    	 local obj = grid[ox][oy]
    	 
    	 if obj and obj.invoke then
    	 	 
    	 	 obj:invoke()
    	 	 
      end
    	 
    	 
    elseif btnp(🅾️) then
		  	 
		  -- open inventory
		  	 
		  	 add_menu(player.inventory)
		  	 
    end
    
    
  end,
  
  drw = function()
    
    -- keep player visible in
    --  current screen before
    --  transitioning
    
    local xos = 0
    local yos = 0
    
    if cam.player_shift and
      cam.⧗[1] > 2
    then
    -- camera is moving
    
    	 for q in all(cam.q) do
    	 	 
    	 	 if q == "⬅️" then
		    	 	 
		    	 	 xos += 8
		    	 	 
		      elseif q == "➡️" then
		    	 	 
		    	 	 xos -= 8
		    	 	 
		      elseif q == "⬆️" then
		    	 	 
		    	 	 yos += 8
		    	 	 
		      elseif q == "⬇️" then
		    	 	 
		    	 	 yos -= 8
		    	 	 
		      end
    	 	 
      end
    	 
    end
    
    
    local px = player.x*8+xos
    local py = player.y*8+yos
    
    -- draw player
    
    spr(player.s, px, py, 1, 1, player.flip_x)
    
    -- draw gear
    
    if player.hand then
    	 
    	 player.hand.drw(px, py)
    	 
    end
    
  end
  
}

grid = {}

for i = 0, 127 do
	 
	 grid[i] = {}
	 
	 for j = 0, 63 do
	 	 
	 	 grid[i][j] = nil
	 	 
  end
	 
end
