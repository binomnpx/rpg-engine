-- actions and dialogue

-------------
-- actions --
-------------

scan = {
  
  name = "scan",
  
  cam_x = nil,
  
  cam_y = nil,
  
  use = function()
    
  	 scan.cam_x = cam.x
  	 scan.cam_y = cam.y
  	 
  	 ctrl = "scan"
  	 cam.ctrl = "scan"
    
  end,
  
  upd = function()
    
    if #cam.q == 0 then
		    
		    if btnp(⬅️) then
		    	 
		    	 add(cam.q, "⬅️")
		    	 
		    elseif btnp(➡️) then
		    	 
		    	 add(cam.q, "➡️")
		    	 
		    elseif btnp(⬆️) then
		    	 
		    	 add(cam.q, "⬆️")
		    	 
		    elseif btnp(⬇️) then
		    	 
		    	 add(cam.q, "⬇️")
		    	 
		    end
		    
		    if #cam.q > 0 then
		    	 
		    	 ctrl = "camera"
		    	 
		    	 add(cam.⧗, 8)
		    	 cam.dxy = 1
		    	 
      end
		    
		  end
    
    if ctrl != "camera" and
      btnp(🅾️)
    then
    	 
    	 local dx = scan.cam_x - cam.x
    	 local dy = scan.cam_y - cam.y
    	       
      if dx != 0 then
      	 
      	 add(cam.q, (dx > 0 and "➡️" or "⬅️"))
      	 
      	 add(cam.⧗, abs(dx))
      	 cam.dxy = 1
      	 
      	 ctrl = "camera"
      	 
      end
      
      if dy != 0 then
      	 
      	 add(cam.q, (dy > 0 and "⬇️" or "⬆️"))
      	 
      	 add(cam.⧗, abs(dy))
      	 cam.dxy = 1
      	 
      	 ctrl = "camera"
      	 
      end
      
      cam.ctrl = "player"
      
    end
    
  end
  
}


drink = {
  
  name = "drink",
  
  use = function()
    
    add_message("glug", player.x, player.y)
    
    deli(player.inventory, menus[#menus-1].index+1)
    
    menu_quit()
    
  end
  
}


toss = {
  
  name = "toss",
  
  use = function()
    
    deli(player.inventory, menus[#menus-1].index+1)
    
    menu_delprev()
    
    menu_return()
    
  end
  
}


target = {
  
  name = "target",
  
  x = nil,
  
  y = nil,
  
  ctrl = nil,
  
  use = function()
    
    local xos = 0
    local yos = 0
    
    if player.s == player_sprite_left then
    	 
    	 xos = player.flip_x and 1 or -1
    	 
    elseif player.s == player_sprite_back then
    	 
    	 yos = -1
    	 
    else
    	 
    	 yos = 1
    	 
    end
    
    target.x = player.x + xos
    target.y = player.y + yos
    
  	 target.ctrl = ctrl
  	 ctrl = "target"
    
  end,
  
  upd = function()
    
    local x0 = target.x
    local y0 = target.y
    
    if btnp(⬅️) then
    	 
    	 target.x -= 1
    	 
    end
    
    if btnp(➡️) then
    	 
    	 target.x += 1
    	 
    end
    
    if btnp(⬆️) then
    	 
    	 target.y -= 1
    	 
    end
    
    if btnp(⬇️) then
    	 
    	 target.y += 1
    	 
    end
    
    if (target.x - player.x)^2 + (target.y - player.y)^2 > menu_get(1).range^2 + menu_get(1).range then
    	 
    	 target.x = x0
    	 target.y = y0
    	 
    end
    
    if btnp(🅾️) then
    	 
    	 ctrl = "menuing"
    	 
    end
    
    if btnp(❎) then
    	 
    	 menu_get(1):invoke()
    	 ctrl = "player"
    	 
    end 
    
  end,
  
  drw = function()
    
    rect(
      target.x*8,
      target.y*8,
      target.x*8+7,
      target.y*8+7,
      8
    )
    
--    spr(22, target.x*8, target.y*8)
    
--    circ(player.x*8+4, player.y*8+4, menu_get(1).range*8+4)
    
  end
  
}


equip = {
  
  name = "equip",
  
  use = function()
    
    player.hand = menu_get(1)
    
    menu_quit()
    
  end
  
}


unequip = {
  
  name = "unequip",
  
  use = function()
    
    player.hand = nil
    
    menu_quit()
    
  end
  
}


--------------
-- dialogue --
--------------

hi = {
  
  name = "hi",
  
  use = function()
    
    add_message("hi", player.x, player.y)
    
    menu_quit()
    
  end
  
}


bye = {
  
  name = "bye",
  
  use = function()
    
    add_message("bye", player.x, player.y)
    
    menu_quit()
    
  end
  
}
-->8
-- attacks

attacks = {}

function add_attack(actor, implement, x, y)
	 
	 add(attacks, {
	   
	   upd = function(self)
	     
	     local obj = grid[x][y]
	     
	     if obj and obj.♥ then
	       
	       obj.♥ -= implement.power
	       
	       add_message(-implement.power.."♥", x, y)
	       
	     end
	     
	     del(attacks, self)
	     
	   end
	   
	 })
	 
end
